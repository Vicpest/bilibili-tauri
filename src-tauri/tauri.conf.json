{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilibili Video Downloader",
  "version": "0.2.0",
  "identifier": "com.example.bilibilidownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Bilibili 视频工具", "width": 1080, "height": 760, "minWidth": 760, "minHeight": 560, "resizable": true }],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": "default-src 'self'; img-src 'self' https: data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
